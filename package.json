{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase serve --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy",
    "logs": "firebase functions:log",
    "run-dev": "minify ../pretty -d ../public/scripts && firebase serve",
    "deploy-all": "minify ../pretty -d ../public/scripts --no-comments --removeConsole && firebase deploy",
    "minify": "minify ../pretty -d ../public/scripts --no-comments --removeConsole",
    "build-functions": "webpack --config webpack.config.js",
    "deploy-hosting": "minify ../pretty -d ../public/scripts --no-comments --removeConsole && firebase deploy --only hosting",
    "deploy-functions": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.4.0",
    "@netlify/functions": "^3.0.0",
    "@sparticuz/chromium": "^113.0.1",
    "blob-stream": "^0.1.3",
    "bufferutil": "^4.0.8",
    "dotenv": "^16.4.7",
    "encoding": "^0.1.13",
    "firebase-admin": "^11.0.0",
    "firebase-functions": "^3.4.0",
    "follow-redirects": "^1.15.2",
    "html-pdf": "^3.0.1",
    "is-buffer": "^2.0.3",
    "jimp": "^1.6.0",
    "jszip": "^3.10.1",
    "kind-of": "^6.0.3",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.13.0",
    "puppeteer": "^24.2.0",
    "puppeteer-core": "^24.2.0",
    "typescript": "^5.7.3",
    "utf-8-validate": "^6.0.4",
    "webflow-api": "^2.3.2"
  },
  "private": true,
  "engines": {
    "node": "18"
  },
  "devDependencies": {
    "@babel/core": "^7.14.6",
    "@babel/preset-env": "^7.14.8",
    "babel-loader": "^8.2.2",
    "babel-minify": "^0.2.0",
    "webpack": "^5.52.0",
    "webpack-cli": "^4.8.0"
  },
  "resolutions": {
    "esbuild": "^0.17.19"
  }
}
